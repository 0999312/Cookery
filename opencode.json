{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "skill": "allow"
  },
  "plugin": ["godot-prompter@git+https://github.com/jame581/GodotPrompter.git"]
  ,
  "mcp": {
    "godot-docs": {
      "type": "local",
      "command": ["npx", "@fernforestgames/mcp-server-godot-docs"],
      "environment": {
        "GODOT_PATH": "E:/godot_learning/Godot_v4.6.2-stable_mono_win64/godot.exe"
      },
      "enabled": true
    },
    "godot-mcp": {
      "type": "local",
      "command": ["npx", "@coding-solo/godot-mcp"],
      "environment": {
        "GODOT_PATH": "E:/godot_learning/Godot_v4.6.2-stable_mono_win64/godot.exe",
        "DEBUG": "true"
      },
      "enabled": true
    }
  }
}
